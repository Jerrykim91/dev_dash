# Prefer: python3 infra/init-env.py --output .env.production
# Secrets below must be generated; no working password is committed.
APP_ENV=production
DEV_AUTH_ENABLED=false
DEV_ADMIN_KEY=
CHANNEL_CAPACITY=15
POSTGRES_DB=nobis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
NOBIS_DB_USER=nobis
NOBIS_DB_PASSWORD=
DOCKER_PLATFORM=linux/arm64
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DEV_HTTP_PORT=5173
DEV_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEVNEST_URL=
DEVNEST_DEV_URL=http://127.0.0.1:8001/

SOCIAL_GROUP_MAX_MEMBERS=30
# Native backend only; Compose uses the private nobis-media volume.
# MEDIA_ROOT=data/media

# Per-home simultaneous occupants, including owner (1..5). New homes default private.
HOME_MAX_OCCUPANTS=5
